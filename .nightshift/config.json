{
    "name":  "clubsy",
    "baseBranch":  "develop",
    "gates":  [
                  {
                      "name":  "client-pub-get",
                      "run":  "cd client \u0026\u0026 flutter pub get",
                      "when":  {
                                   "fileExists":  "client/pubspec.yaml"
                               }
                  },
                  {
                      "name":  "client-format",
                      "run":  "cd client \u0026\u0026 dart format .",
                      "when":  {
                                   "fileExists":  "client/pubspec.yaml"
                               },
                      "autoFix":  true
                  },
                  {
                      "name":  "client-analyze",
                      "run":  "cd client \u0026\u0026 flutter analyze --no-fatal-infos",
                      "when":  {
                                   "fileExists":  "client/pubspec.yaml"
                               }
                  },
                  {
                      "name":  "client-test",
                      "run":  "cd client \u0026\u0026 flutter test --coverage",
                      "when":  {
                                   "fileExists":  [
                                                      "client/pubspec.yaml",
                                                      "client/test"
                                                  ]
                               },
                      "countTests":  true
                  },
                  {
                      "name":  "server-install",
                      "run":  "cd server \u0026\u0026 pnpm install",
                      "when":  {
                                   "fileExists":  "server/package.json"
                               }
                  },
                  {
                      "name":  "server-test",
                      "run":  "cd server \u0026\u0026 pnpm test",
                      "when":  {
                                   "fileExists":  "server/package.json"
                               },
                      "countTests":  true,
                      "testCountPattern":  "Tests:\\s+(?:\\d+ \\w+, )*(\\d+) passed"
                  }
              ],
    "services":  {

                 },
    "protectedPaths":  {

                       },
    "reviewExclude":  [
                          ":(exclude)client/pubspec.lock",
                          ":(exclude)server/pnpm-lock.yaml",
                          ":(exclude)**/*.png",
                          ":(exclude)**/*.jpg"
                      ],
    "batch":  {
                  "maxTasks":  1,
                  "maxTextLength":  600
              },
    "agentTimeoutMinutes":  75,
    "gateTimeoutMinutes":  30,
    "agentMaxBudgetUsd":  8,
    "branchPrefix":  "night/",
    "worktree":  {
                     "setup":  [
                                   "cd client \u0026\u0026 flutter pub get",
                                   "cd server \u0026\u0026 pnpm install"
                               ],
                     "copy":  [
                                  "server/.env"
                              ]
                 }
}