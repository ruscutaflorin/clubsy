# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clubsy

# Secret used to sign JWTs (required). Generate a long random string.
JWT_SECRET=change-me

# Token lifetime (jsonwebtoken format). Default: 30d
JWT_EXPIRES_IN=30d

# HTTP port. Default: 3000
PORT=3000

# development | production. Production restricts CORS and quiets logs.
NODE_ENV=development

# Comma-separated browser origins allowed by CORS.
# Unset: allow all outside production, none in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Max sign-in/sign-up requests per IP per minute. Default: 10
RATE_LIMIT_AUTH_PER_MIN=10

# Max check-in requests per user per minute. Default: 6
RATE_LIMIT_CHECKIN_PER_MIN=6

# Set to 1 to log every SQL query from Prisma (otherwise only warn/error)
# PRISMA_LOG_QUERIES=1

# Seed script (pnpm seed): admin user to create. Skipped if unset.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-password

# Email sender for password reset codes. Both are required in production;
# without RESEND_API_KEY the code is printed to the console instead.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Clubsy <no-reply@example.com>

# Password reset requests per hour: per email (default 5) and per IP (default 20)
# RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
# RATE_LIMIT_PASSWORD_RESET_IP_PER_HOUR=20
